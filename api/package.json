{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "db:migrate": "tsx scripts/migrate.ts",
    "seed:validate": "tsx scripts/validate-seeds.ts",
    "seed:auth": "tsx scripts/seed-auth.ts",
    "verify": "tsx scripts/verify.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@node-rs/argon2": "^2.2.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.5",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.24.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
